{
  "name": "@lucasriondel/gousse-ui",
  "version": "0.4.1",
  "private": true,
  "description": "Gousse design-system primitives (React 19 + Tailwind v4) — distributed as a shadcn registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasriondel/gousse-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./effects.css": "./dist/effects.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && bun run copy-css",
    "copy-css": "cp src/tokens.css src/theme.css src/effects.css dist/",
    "prepack": "bun run build",
    "build-registry": "bun scripts/build-registry.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "bun test",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "sandcastle": "bun .sandcastle/main.ts",
    "sandcastle:implement": "bun .sandcastle/implement/index.ts",
    "sandcastle:implement-review": "bun .sandcastle/implement-review/index.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@storybook/addon-themes": "^10",
    "@storybook/react-vite": "^10",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "storybook": "^10",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
